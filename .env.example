# =========================================================================
# School OS API — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# =========================================================================

# --- Application ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
APP_NAME=school-os-api
API_V1_PREFIX=/api/v1

# --- Security ------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-random-64-byte-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Database ------------------------------------------------------------
# App connects as the RLS-enforced login role. Never a superuser.
DATABASE_URL=postgresql+asyncpg://school_os_app:school_os_app_dev@localhost:5432/school_os
# Alembic connects as the BYPASSRLS migration role.
MIGRATION_DATABASE_URL=postgresql+asyncpg://school_os_migrator:school_os_migrator_dev@localhost:5432/school_os
# Integration tests target a dedicated database.
TEST_DATABASE_URL=postgresql+asyncpg://school_os_app:school_os_app_dev@localhost:5432/school_os_test
# The sync scripts (permissions, roles) and bootstrap connect as the migrator
# so they can write system rows regardless of RLS.
SYNC_DATABASE_URL=postgresql+asyncpg://school_os_migrator:school_os_migrator_dev@localhost:5432/school_os

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Rate limiting (Phase 3: Redis-backed, Upstash in prod) ---------------
LOGIN_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
# Upstash Redis URL (rediss://... with TLS in production).
# Empty = in-memory fallback (local dev / tests).
REDIS_URL=
REDIS_POOL_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# --- Documents / Uploads (Phase 3: Cloudflare R2) --------------------------
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=school-os-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
MAX_UPLOAD_SIZE_BYTES=52428800
# Comma-separated whitelist is parsed by the app when set as a plain string.
# (pydantic-settings parses JSON lists; keep default in code.)

# --- Timeouts (Phase 3) ----------------------------------------------------
BULK_IMPORT_TIMEOUT_SECONDS=300
DOCUMENT_CONFIRM_TIMEOUT_SECONDS=10

# --- Outbox dispatcher (Phase 3) -------------------------------------------
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5

# --- Bootstrap (scripts/bootstrap.py) ------------------------------------
BOOTSTRAP_ORG_CODE=demo
BOOTSTRAP_ORG_NAME=Demo Education Trust
BOOTSTRAP_SCHOOL_CODE=demo-hs
BOOTSTRAP_SCHOOL_NAME=Demo High School
BOOTSTRAP_ADMIN_EMAIL=admin@demo.test